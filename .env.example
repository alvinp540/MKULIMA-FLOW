# Django
DJANGO_SECRET_KEY=replace-with-a-new-secret-key
DJANGO_DEBUG=False
# Railway injects RAILWAY_PUBLIC_DOMAIN and adds it to ALLOWED_HOSTS/CSRF
# automatically. Add custom domains here when you attach one.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cross-origin frontend (Vercel). Comma-separated origins, no trailing slash.
# Leave blank for local development; the Vite dev proxy keeps /api same-origin.
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=True
# Never enable CORS_ALLOW_ALL_ORIGINS in production.
CORS_ALLOW_ALL_ORIGINS=False
# Set automatically to None when CORS_ALLOWED_ORIGINS is set and DEBUG=False.
# Override only if you know what you are doing.
DJANGO_COOKIE_SAMESITE=
# HSTS is enabled in production. Disable only if a custom domain has
# subdomains that must remain HTTP.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_HSTS_PRELOAD=True

# Email (password reset / admin emails). Console is used only when DEBUG=True.
DJANGO_EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@localhost

# Visa/PayPal have no live gateway integration yet. Set True on a staging
# deployment to keep the clearly-labelled demo checkout working with DEBUG=False.
PAYMENTS_DEMO_MODE=False

# Database: set DATABASE_URL, or the DB_* values below.
# Local development uses the local PostgreSQL 18 server on 127.0.0.1:5432
# with a `mkulimaflow` role and database.
DATABASE_URL=
DB_NAME=mkulimaflow
DB_USER=mkulimaflow
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432
# Set to "require" only when the server enforces TLS (e.g. Aiven or Railway).
# Leave empty for the local server.
DB_SSLMODE=
DB_CONNECT_TIMEOUT=10

# Redis (optional). On Railway, connect a Redis service and set REDIS_URL to
# ${{Redis.REDIS_URL}}. Leave it blank locally to use an in-memory cache and
# DB-backed sessions. REDIS_PUBLIC_URL is only needed for an external Redis.
REDIS_URL=
REDIS_PUBLIC_URL=
REDIS_ENABLED=True
REDIS_IGNORE_EXCEPTIONS=True
REDIS_MAX_CONNECTIONS=50
CACHE_TIMEOUT=300
CACHE_KEY_PREFIX=mkulimaflow

# M-Pesa (Safaricom Daraja)
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Leave blank on Railway to auto-build from RAILWAY_PUBLIC_DOMAIN.
MPESA_CALLBACK_URL=
MPESA_CALLBACK_SECRET=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_USD_TO_KES_RATE=130
